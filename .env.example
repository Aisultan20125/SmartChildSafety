# ==========================================
# Telegram Bot Settings
# ==========================================
# Your bot token obtained from @BotFather
TELEGRAM_TOKEN=

# Your personal Telegram Chat ID (can be retrieved via @userinfobot)
TELEGRAM_CHAT_ID=

# ==========================================
# Application Settings
# ==========================================
# Camera index (0 for built-in, 1 for external/Iriun via USB)
CAMERA_INDEX=1

# Local port for the Flask web dashboard
FLASK_PORT=5000

# URL for the Web App button in Telegram (local IP or ngrok)
LOCAL_WEB_URL=
