# ==========================================
# Python & Virtual Environments
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so

# Виртуальные окружения
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ==========================================
# AI Models & Large Datasets (ИИ и Веса)
# ==========================================
