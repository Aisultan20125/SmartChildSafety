*.pt
*.onnx
*.engine
*.bin
*.weights
*.h5
*.pkl
datasets/
data/
runs/
*.mp4
*.avi

# ==========================================
# Configuration & Secrets (Переменные окружения)
# ==========================================
# Токен Telegram-бота и секретные ключи Flask нельзя сливать в публичный репозиторий
.env
.env.local
config.py
secrets.json

# ==========================================
# IDEs & Code Editors
# ==========================================
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# PyCharm / IntelliJ
.idea/

# ==========================================
# System Files
# ==========================================
.DS_Store
Thumbs.db
*.tmp
*.log
logs/
